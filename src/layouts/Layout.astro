---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ataqah Ramadhan, design engineer building AI agents",
  description = "Ataqah Ramadhan designs interfaces and builds the AI agents behind them. 2nd place, AWS × SAP Agentic AI University Hackathon 2026. Computer Science student in Jakarta, open to internships from mid-2027.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2ede4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- Social preview: name in orange with the portrait, 1200 × 630. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ATAQAH in orange Bodoni with Ataqah Ramadhan's portrait" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Hide motion-managed elements before first paint, but only when JS runs and motion is allowed. -->
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        // Safety net: if the intro script never starts, show everything as-is.
        setTimeout(() => {
          if (!window.__introStarted) document.documentElement.classList.remove("motion");
        }, 2500);
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
